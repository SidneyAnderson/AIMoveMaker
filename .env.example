# ============================================================================
# AI Movie Maker - Environment Variables
# ============================================================================
# Copy to .env and fill in required values:
#   cp .env.example .env
#
# Only infrastructure config lives here. All other configuration (API keys,
# SMTP credentials, OAuth client IDs) is stored in the Setting table managed
# at runtime by the Admin. See PRD Section 12.6.
# ============================================================================

# --------------------------------------------------------------------------
# Database (required)
# --------------------------------------------------------------------------
# SQLAlchemy async database URL.
# Dev default: SQLite via aiosqlite
# Production: PostgreSQL 15+ via asyncpg
#   Example: postgresql+asyncpg://user:pass@localhost:5432/aimoviemaker
DATABASE_URL=sqlite+aiosqlite:///./data/dev.db

# --------------------------------------------------------------------------
# Redis (required)
# --------------------------------------------------------------------------
# Redis 7+ connection URL for Celery task queue and pub/sub streaming.
REDIS_URL=redis://localhost:6379/0

# --------------------------------------------------------------------------
# JWT Secret (required)
# --------------------------------------------------------------------------
# HS256 signing key for access/refresh tokens.
# Generate with:  openssl rand -hex 32
# WARNING: Never commit a real secret. setup.sh auto-generates one if blank.
SECRET_KEY=

# --------------------------------------------------------------------------
# Environment (optional)
# --------------------------------------------------------------------------
# "development" or "production". Controls debug mode and log level.
ENVIRONMENT=development

# --------------------------------------------------------------------------
# Logging (optional)
# --------------------------------------------------------------------------
# Minimum log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# --------------------------------------------------------------------------
# Storage (optional)
# --------------------------------------------------------------------------
# Root path for all file storage (assets, outputs, snapshots, models).
STORAGE_BASE_PATH=./storage

# --------------------------------------------------------------------------
# Frontend environment variables (set in frontend/.env if needed)
# --------------------------------------------------------------------------
# Backend API base URL used by the React frontend Vite proxy.
# VITE_API_URL=http://localhost:8000

# Backend WebSocket base URL used by the React frontend.
# VITE_WS_URL=ws://localhost:8000
